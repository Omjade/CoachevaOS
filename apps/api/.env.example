# Render sets PORT automatically at runtime — only needed here for local dev,
# where it defaults to 8000 if you run uvicorn without --port.
PORT=8000
# "development" disables the production-only startup checks (e.g. refusing to
# boot on the default JWT_SECRET) and keeps cookies non-secure for plain HTTP
# local dev. Set to "production" on Render.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.neon.tech/coachevaos?ssl=require
JWT_SECRET=change-me-to-a-random-value
# Only "true" over real HTTPS (Render, or any real deploy) — a plain-HTTP
# local dev server can't set a Secure cookie at all, so this must stay false
# for localhost.
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/integrations/google/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/integrations/zoom/callback
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:8000/integrations/calendly/callback
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=
CALCOM_REDIRECT_URI=http://localhost:8000/integrations/calcom/callback
# The app's own canonical frontend URL — used both for CORS and to build
# redirect/callback links (invite emails, OAuth returns, etc). Set this to
# https://coachevaos.com in production. coachevaos.com, www.coachevaos.com,
# and localhost:3000 are always allowed for CORS regardless of this value
# (see Settings.cors_origins in app/config.py) — only set CORS_EXTRA_ORIGINS
# below if you need to allow something beyond those, e.g. a staging preview URL.
FRONTEND_URL=http://localhost:3000
# This backend's own publicly reachable base URL — used only to build the
# outbound webhook subscription URL registered with Calendly/Cal.com at
# connect time (they need a real internet-reachable callback, never
# localhost). Set to your real deployed API domain, e.g.
# https://api.coachevaos.com — forgetting this means external Calendly/
# Cal.com bookings silently won't sync into CoachevaOS's calendar (the
# same class of bug as GOOGLE_CALENDAR_REDIRECT_URI defaulting to localhost).
API_BASE_URL=http://localhost:8000
CORS_EXTRA_ORIGINS=["https://coachevaos.com","https://www.coachevaos.com"]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
S3_BUCKET=coachevaos
S3_PREFIX=Coaches Client Files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
PADDLE_ENVIRONMENT=sandbox
PAYMENT_GRACE_PERIOD_DAYS=4
GEO_LOOKUP_ENABLED=true
PADDLE_API_KEY=
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_GROWTH_MONTHLY=
PADDLE_PRICE_GROWTH_ANNUAL=
PADDLE_PRICE_SCALE_MONTHLY=
PADDLE_PRICE_SCALE_ANNUAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
SALES_CONTACT_EMAIL=sales@coachevaos.com
# Defense-in-depth on top of webhook signature verification. Confirmed for
# this deployment: no reverse proxy in front, so PADDLE_WEBHOOK_TRUST_PROXY_HEADER
# stays false permanently — only flip it if that ever changes and the new
# proxy overwrites (not appends to) X-Forwarded-For.
# Leave PADDLE_WEBHOOK_IP_ALLOWLIST_ENABLED=false while testing through a
# local tunnel (ngrok/cloudflared) — the tunnel, not Paddle, is what the app
# sees as the connecting IP, so the allowlist would reject real Paddle
# deliveries. Set it to true only in the actual deployed (staging/live)
# environment, where the API is reached directly.
PADDLE_WEBHOOK_IP_ALLOWLIST_ENABLED=false
PADDLE_WEBHOOK_TRUST_PROXY_HEADER=false
