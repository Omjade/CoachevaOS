# Local dev value shown here. In Vercel's project env vars, set this to
# https://api.coachevaos.com for Production and Preview — lib/api.ts falls
# back to that value automatically if it's ever left unset in a prod build,
# but don't rely on the fallback; set it explicitly.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SALES_EMAIL=sales@coachevaos.com
# Must include "www" — the live domain 308-redirects the non-www host to
# this one, so a non-www value here makes every canonical/sitemap/OG URL
# point at a redirect instead of the real page (this caused Search
# Console's "Page with redirect" indexing errors). Drives sitemap.xml,
# robots.txt, metadataBase, and every Open Graph/canonical URL.
NEXT_PUBLIC_SITE_URL=https://www.coachevaos.com
# Empty by default (inert) — set once a real GA4 property exists. Analytics
# won't fire even when set until the visitor accepts cookies (see CookieConsent.tsx).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
